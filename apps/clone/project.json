{
  "name": "clone",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/clone",
  "tags": [
    "type:static"
  ],
  "targets": {
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite apps/clone --open"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": [
        "{workspaceRoot}/dist/clone"
      ],
      "options": {
        "command": "mkdir -p dist/clone && rsync -a --exclude=project.json --exclude=.DS_Store apps/clone/ dist/clone/"
      }
    }
  }
}
